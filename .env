# OTP email delivery via Gmail with an App Password.
# Create one at https://myaccount.google.com/apppasswords (requires 2FA on the Google account),
# then set SMTP_USER to the Gmail address and SMTP_PASS to the 16-char app password.
# While unset, OTP login falls back to showing the code in the API response (dev mode).
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: {APP_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=
