# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets never go in git; .env.example is the template
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local databases (created by `bun run db:push` and `bun run db:seed`)
db/*.db
db/*.db-journal

# logs
*.log

# local-only files
local-*

# ---------------------------------------------------------------------------
# Sandbox / development-container scaffolding — NOT part of the ForgeOS
# product. These live in the dev workspace only and are intentionally kept
# out of the repository.
# ---------------------------------------------------------------------------
/.zscripts/
/agent-ctx/
/tool-results/
/skills/
/examples/
/mini-services/
/upload/
/download/
/Caddyfile
/.initial_snapshot.json
/.z-ai-config/
/.claude/
/tests/python-runtime-*.sh
/tests/database-runtime-build.sh
