// ForgeOS — construction ERP for Indian builders (original contract)
// SQLite datasource; enum-like fields are stored as strings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String // scrypt; empty for OAuth-only accounts
  role         String // ADMIN | PM | VIEWER
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  managedProjects Project[]              @relation("ProjectPM")
  createdProjects Project[]              @relation("ProjectCreatedBy")
  createdLands    Land[]
  dailyLogs       DailyLog[]
  recordedTxns    InventoryTransaction[] @relation("TxnCreatedBy")
  voidedTxns      InventoryTransaction[] @relation("TxnVoidedBy")
  plans           MaterialPlan[]
  oauthAccounts   OAuthAccount[]
}

model OAuthAccount {
  id                String   @id @default(cuid())
  provider          String // "google"
  providerAccountId String
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
}

model OtpCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String // scrypt of the 6-digit code
  purpose    String    @default("LOGIN")
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email])
}

model Land {
  id           String    @id @default(cuid())
  name         String
  addressLine  String?
  city         String
  state        String
  pincode      String?
  areaValue    Float
  areaUnit     String // SQFT | SQYD | SQM | ACRE
  surveyNumber String?
  ownerName    String?
  purchaseDate DateTime?
  purchaseCost Float?
  notes        String?
  createdById  String
  createdBy    User      @relation(fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  projects Project[]
}

model Project {
  id                  String    @id @default(cuid())
  code                String    @unique // FOS-001
  name                String
  description         String?
  location            String?
  landId              String
  land                Land      @relation(fields: [landId], references: [id])
  status              String    @default("PLANNING") // PLANNING | ACTIVE | ON_HOLD | COMPLETED
  startDate           DateTime
  expectedEndDate     DateTime?
  actualEndDate       DateTime?
  totalBudget         Float     @default(0)
  wastageThresholdPct Float     @default(10)
  assignedPmId        String?
  assignedPm          User?     @relation("ProjectPM", fields: [assignedPmId], references: [id], onDelete: SetNull)
  createdById         String
  createdBy           User      @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  plans        MaterialPlan[]
  transactions InventoryTransaction[]
  logs         DailyLog[]
  milestones   Milestone[]
  invoices     Invoice[]
  auditLogs    AuditLog[]
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  address   String?
  createdAt DateTime @default(now())

  transactions InventoryTransaction[]
}

model Material {
  id          String   @id @default(cuid())
  name        String   @unique
  unit        String
  category    String // CEMENT | STEEL | SAND_AGGREGATE | BRICKS_BLOCKS | TIMBER | ELECTRICAL | PLUMBING | PAINT_FINISH | OTHER
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plans        MaterialPlan[]
  transactions InventoryTransaction[]
}

model MaterialPlan {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  materialId        String
  material          Material @relation(fields: [materialId], references: [id])
  openingQuantity   Float    @default(0)
  plannedQuantity   Float
  plannedUnitRate   Float?
  lowStockThreshold Float?
  wastageThresholdPct Float?
  status            String   @default("DRAFT") // DRAFT | APPROVED | ARCHIVED
  notes             String?
  createdById       String
  createdBy         User     @relation(fields: [createdById], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([projectId, materialId])
}

model InventoryTransaction {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  materialId    String
  material      Material  @relation(fields: [materialId], references: [id])
  vendorId      String?
  vendor        Supplier? @relation(fields: [vendorId], references: [id])
  txnType       String // IN | OUT | ADJUSTMENT
  quantity      Float // IN/OUT > 0; ADJUSTMENT stored signed (+inc / −dec)
  unitRate      Float?
  challanNumber String?
  outReason     String? // USED | DAMAGED | LOST (for OUT)
  txnDate       DateTime
  dailyLogId    String?
  dailyLog      DailyLog? @relation(fields: [dailyLogId], references: [id], onDelete: SetNull)
  remarks       String?
  recordedById  String
  recordedBy    User      @relation("TxnCreatedBy", fields: [recordedById], references: [id])
  voidedAt      DateTime?
  voidReason    String?
  voidedById    String?
  voidedBy      User?     @relation("TxnVoidedBy", fields: [voidedById], references: [id])
  createdAt     DateTime  @default(now())

  @@index([projectId])
  @@index([txnDate])
}

model DailyLog {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  logDate         DateTime
  progressPercent Float
  workSummary     String
  weather         String?
  issues          String?
  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  labourEntries     LabourEntry[]
  machineryEntries  MachineryEntry[]
  transactions      InventoryTransaction[]

  @@unique([projectId, logDate])
  @@index([projectId])
}

model LabourEntry {
  id             String   @id @default(cuid())
  dailyLogId     String
  dailyLog       DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  trade          String
  contractorName String?
  headCount      Int
  hoursWorked    Float    @default(8)
  remarks        String?
}

model MachineryEntry {
  id           String   @id @default(cuid())
  dailyLogId   String
  dailyLog     DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  machineName  String
  operatorName String?
  hoursUsed    Float
  fuelLitres   Float?
  remarks      String?
}

model Milestone {
  id               String    @id @default(cuid())
  projectId        String
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  sequence         Int
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?
  status           String    @default("PLANNED") // PLANNED | IN_PROGRESS | COMPLETED | ON_HOLD | CANCELLED
  progressPercent  Float     @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([projectId, sequence])
}

model Invoice {
  id        String   @id @default(cuid())
  invoiceNo String   @unique // INV-2026-001
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amount    Float // pre-GST
  gstPct    Float    @default(0)
  status    String   @default("DRAFT") // DRAFT | SENT | PARTIALLY_PAID | PAID | VOID
  issueDate DateTime
  dueDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Float
  method    String // CASH | BANK | UPI | CHEQUE
  reference String?
  paidAt    DateTime
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String    @id @default(cuid())
  actorId    String?
  actorName  String?
  action     String
  entityType String?
  entityId   String?
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  meta       String? // JSON string
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([projectId])
}
