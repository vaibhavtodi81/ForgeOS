# Selects the runtime mode so logging and development behavior can be configured.
NODE_ENV=development
# Sets the local TCP port on which the HTTP server listens.
PORT=4000
# Tells Prisma how to connect to PostgreSQL; replace these local example credentials for your environment.
DATABASE_URL=postgresql://forgeos_user:forgeos_dev_password@localhost:5432/forgeos_db?schema=public
# Lists the frontend origin allowed to make browser requests to this API.
CORS_ORIGIN=http://localhost:5180
# Sets the minimum severity of server messages written to the logs.
LOG_LEVEL=info
# Provides the signing secret for access tokens; replace this example with a long, random secret.
# Signs access tokens; replace this example with a long, random secret.
JWT_SECRET=replace_with_at_least_32_random_characters
# Sets how long an access token remains valid before clients must authenticate again.
JWT_EXPIRES_IN=15m
# File purpose: Shows safe environment-variable names and example values for server.
